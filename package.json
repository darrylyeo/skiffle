{
	"name": "skiffle",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"tunnel:ngrok": "ngrok http http://127.0.0.1:5173",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:integration:snap": "playwright test -c playwright-snap-e2e.config.ts",
		"test:integration:snap:headed": "playwright test -c playwright-snap-e2e.config.ts --headed",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-netlify": "^5.2.4",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^25.5.2",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tslib": "^2.8.1",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3"
	},
	"dependencies": {
		"@datawrapper/twemoji-svg": "^1.1.0",
		"@farcaster/jfs": "^0.3.0",
		"@fontsource/fira-code": "^5.2.7",
		"@fontsource/noto-sans-jp": "^5.2.9",
		"@fontsource/noto-sans-symbols-2": "^5.2.8",
		"@fontsource/ubuntu": "^5.2.8",
		"@resvg/resvg-js": "^2.6.2",
		"satori": "^0.26.0",
		"satori-html": "^0.3.2",
		"twemoji": "^14.0.2",
		"viem": "^2.47.10"
	},
	"type": "module"
}
